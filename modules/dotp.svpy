//; # enddef
//;
//; # Helper functions are collected while the datapath is built and emitted once each at the
//; # end of the module, keyed by everything that shapes their body.
//; funcs = {}
//; def collect(leaf, key, name, order, params, user):
//;     if key not in funcs:
//;         taken = {f['name'] for f in funcs.values()}
//;         base, k = name, 0
//;         while name in taken:
//;             k += 1
//;             name = f'{base}_{k}'
//;         # endwhile
//;         funcs[key] = {'leaf': leaf, 'name': name, 'order': (*order, len(funcs)),
