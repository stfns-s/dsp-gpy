//; def req_rec(step, tap, rq):
//;     return {'step': step, 'tap': tap, 'src': rq.src.to_q(), 'dst': rq.dst.to_q(),
//;         'mode': rq.mode, 'osym': bool(rq.osym), 'lossless': bool(rq.lossless),
//;         'sat_reachable': bool(rq.sat_reachable)}
//; # enddef
//; REQUANT  = [req_rec('trim', t.index, t.trim) for t in taps]
