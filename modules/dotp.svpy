//; # enddef
//;
//; def summed(terms):
//;     return parenthesize(terms) if PARENTH else ' + '.join(terms)
//; # enddef
//;
//; # checks: reject a configuration the datapath cannot honor
//; if not isinstance(N_TAPS, int) or N_TAPS < 1:
//;     error(f"{mname}: N_TAPS ({N_TAPS}) must be >= 1")
//; # endif
//; TRMSMPL_L    = broadcast('Q_TRMSMPL', Q_TRMSMPL)
//; COEF_L       = broadcast('Q_COEF',    Q_COEF)
//; TAP_GROUPS_L = None if TAP_GROUPS is None else broadcast('TAP_GROUPS', TAP_GROUPS)
//; PIPE_L       = pipe_stages(PIPE)
//; ROUNDS = (('TRMSMPL_ROUND', TRMSMPL_ROUND), ('PROD_ROUND', PROD_ROUND),
