//; # endif
//; for t in taps:
//;     # the target format is the container of the image, so this requant cannot clamp
//;     t.prod_rq = derive(qfmt.requant, t.prod_bounds, PROD_FRAC, PROD_ROUND)
//; # endfor
//; if (isinstance(N_GROUPS, bool) or not isinstance(N_GROUPS, int)
//;         or not 1 <= N_GROUPS <= len(taps)):
