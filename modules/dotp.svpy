//; REQUANT += [req_rec('out', None, out_rq)]
//; parameter('Q_TRMSMPL',      [t.trmsmpl_fmt.to_q() for t in taps], force=True)
//; parameter('Q_COEF',         [t.coef_fmt.to_q() for t in taps], force=True)
//; parameter('Q_PROD',         [t.prod_rq.dst.to_q() for t in taps], force=True)
//; parameter('Q_GROUPS',       [b.fmt().to_q() for b in group_bounds], force=True)
