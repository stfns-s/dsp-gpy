//; # and the body's declaration and name columns. A registered net is written
//; # 'reg <decl> <name>;' and so takes no name column.
//; port_decls  = [decl(result_fmt), decl(sample_fmt), decl(N_TAPS, signed=False)]
//; port_decls += [decl(t.coef_fmt) for t in taps]
//; port_w      = max(len(d) for d in port_decls)
//; body_fmts   = [t.trmsmpl_fmt for t in taps] + [t.prod_bounds.fmt() for t in taps]
//; body_fmts  += [t.prod_rq.dst for t in taps] + [b.fmt() for b in group_bounds] + [sum_fmt]
//; body_decls  = [decl(f) for f in body_fmts]
//; if TAP_PIPE:
