//; # endif
//; decl_w      = max(len(d) for d in body_decls)
//; wires       = [idx('prod', t.index, N_TAPS, IDX_W) for t in taps] + ['sum']
//; wires      += ['t_clk'] if TAP_PIPE else []
//; wires      += [idx('qsample', t.index, N_TAPS, IDX_W) for t in taps if not pipe_trmsmpl]
//; wires      += [] if TAP_PIPE else [idx('gsample', t.index, N_TAPS, IDX_W) for t in taps]
//; if not pipe_prod:
//;     wires  += [idx('qprod', t.index, N_TAPS, IDX_W) for t in taps]
//; # endif
//; if not pipe_groups:
//;     wires  += [idx('gsum', g, N_GROUPS, IDX_W) for g in range(N_GROUPS)]
//; # endif
//; name_w = max(len(n) for n in wires)
\`ifndef `GUARD`
\`define `GUARD`
// fixed-point dot product: per-tap trim, multiply, requant to one binary point, grouped
// sum, output requant. `N_TAPS` taps; sample `sample_fmt`, result `result_fmt`;
// PROD_FRAC=`PROD_FRAC`; latency `latency_smpl` from sample, `latency_coef` from coef.
// A tap whose tap_en bit is clear `'holds its last product' if TAP_PIPE else 'contributes zero'`.
//; for t in taps:
//   tap `t.index`: `tap_note(t)`, group `t.group`
//; # endfor
//; for g, members in enumerate(groups):
//   group `g`: taps `[t.index for t in members]`, gsum `group_bounds[g].fmt()`
//; # endfor
//   sum `sum_fmt`
module `mname` (
        output `'reg ' if pipe_result else 'wire'` `decl(result_fmt).ljust(port_w)` result,
        input  wire `decl(sample_fmt).ljust(port_w)` sample`xdim`,
//; for t in taps:
        input  wire `decl(t.coef_fmt).ljust(port_w)` `idx('coef', t.index, N_TAPS, IDX_W)`,
//; # endfor
//; # tap_en and clk are always ports, so the interface does not change with the parameters
        input  wire `decl(N_TAPS, signed=False).ljust(port_w)` tap_en,
        input  wire `' ' * port_w` clk
    );

//; if TAP_PIPE:
//;     # one clock per tap. tap_en has to change away from the rising edge of clk, or the
//;     # gate passes a spurious edge; every testbench here drives it at the negedge.
    wire `decl(N_TAPS, signed=False).ljust(decl_w)` `'t_clk'.ljust(name_w)` = {`N_TAPS`{clk}} & tap_en;
//; elif not (pipe_groups or pipe_result):
    // nothing is registered in this configuration, so nothing reads clk; the port is there
    // because the interface does not change with the parameters
    wire unused_clk = clk;
//; # endif

//; for t in taps:
//;     i, fs = t.index, t.trmsmpl_fmt
//;     qsample, prod, qprod = (idx('qsample', i, N_TAPS, IDX_W), idx('prod', i, N_TAPS, IDX_W),
//;         idx('qprod', i, N_TAPS, IDX_W))
//;     src = sample_elem(i)
//;     if t.trim.shift > 0 or t.trim.sat_lo or t.trim.sat_hi:
//;         src = f"{qcvt('trim', t.trim, True, qsample)}({src})"
//;     # endif
//;     operand, opexpr = qsample, src
//;     if not TAP_PIPE:
//;         # with no register to gate, a disabled tap feeds the multiplier a zero sample so
//;         # it does not toggle; the trimmed value keeps its own net because a function call
//;         # cannot sit in a ternary
    wire `decl(fs).ljust(decl_w)` `qsample.ljust(name_w)` = `src`;
//;         operand = idx('gsample', i, N_TAPS, IDX_W)
//;         opexpr  = f"tap_en[{i}] ? {qsample} : {lit(0, fs.width)}"
//;     # endif
//;     if pipe_trmsmpl:
    reg  `decl(fs).ljust(decl_w)` `operand`;
    always @(posedge t_clk[`i`])
        `operand` <= `opexpr`;
//;     else:
    wire `decl(fs).ljust(decl_w)` `operand.ljust(name_w)` = `opexpr`;
//;     # endif
//;     pf    = t.prod_bounds.fmt()
//;     coef  = sx(idx('coef', i, N_TAPS, IDX_W), t.coef_fmt.width, pf.width, prod)
//;     pexpr = f"{coef} * {sx(operand, fs.width, pf.width, prod)}"
    wire `decl(pf).ljust(decl_w)` `prod.ljust(name_w)` = `pexpr`;
//;     rq = t.prod_rq
//;     if rq.shift > 0:
//;         qexpr = f"{qcvt('prod', rq, False, qprod)}({prod})"
//;     elif rq.shift < 0:
//;         qexpr = pad_low(prod, -rq.shift)
//;     else:
//;         qexpr = prod
//;     # endif
//;     if pipe_prod:
    reg  `decl(rq.dst).ljust(decl_w)` `qprod`;
    always @(posedge t_clk[`i`])
        `qprod` <= `qexpr`;
//;     else:
    wire `decl(rq.dst).ljust(decl_w)` `qprod.ljust(name_w)` = `qexpr`;
//;     # endif

//; # endfor
//; for g, members in enumerate(groups):
//;     gsum, gf = idx('gsum', g, N_GROUPS, IDX_W), group_bounds[g].fmt()
//;     gexpr    = summed([sx(idx('qprod', t.index, N_TAPS, IDX_W), t.prod_rq.dst.width, gf.width, gsum)
//;         for t in members])
//;     if pipe_groups:
//;         lines = sum_lines(f"        {gsum} <= ", gexpr)
    reg  `decl(gf).ljust(decl_w)` `gsum`;
    always @(posedge clk)
