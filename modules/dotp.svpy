//; # enddef
//;
//; def qcvt(role, rq, saturate, user):
//;     b = rq.src_bounds
//;     key = ('f_qcvt', rq.src.to_q(), rq.dst.to_q(), rq.mode, rq.osym, b.lo, b.hi, saturate)
//;     params = {'q_in': rq.src.to_q(), 'q_out': rq.dst.to_q(), 'round_mode': rq.mode,
//;         'osym': int(rq.osym), 'src_lo': b.lo, 'src_hi': b.hi, 'saturate': int(saturate),
//;         'lifetime': 'automatic'}
//;     order = ({'trim': 0, 'prod': 1, 'out': 2}[role],)
//;     return collect('f_qcvt.svpy', key, f'f_{role}_{qname(rq.src)}__{qname(rq.dst)}', order,
//;         params, user)
//; # enddef
//;
//; def sx(term, iwidth, owidth, user):
//;     if owidth == iwidth:
//;         return term
//;     # endif
//;     params = {'iwidth': iwidth, 'owidth': owidth, 'lifetime': 'automatic'}
//;     name = collect('f_sx.svpy', ('f_sx', iwidth, owidth), f'f_sx_{iwidth}__{owidth}',
//;         (3, iwidth, owidth), params, user)
//;     return f'{name}({term})'
//; # enddef
//;
//; # A sum longer than the line is broken after a '+', continuation lines under the first term
//; def wrap_expr(expr, indent, width=100):
//;     parts = expr.split(' + ')
//;     lines, cur = [], parts[0]
//;     for part in parts[1:]:
//;         if indent + len(cur) + len(part) + 4 > width:
//;             lines.append(cur + ' +')
//;             cur = part
//;         else:
//;             cur = f'{cur} + {part}'
//;         # endif
//;     # endfor
//;     return lines + [cur]
//; # enddef
//;
//; def sum_lines(head, expr):
//;     # The statement head is a string because wrap_expr needs its width to indent the
//;     # continuation lines under the first term.
//;     lines = wrap_expr(expr, len(head))
//;     pad   = ' ' * len(head)
