//; # Fixed-point dot product of N_TAPS samples and N_TAPS coefficients:
//; #     result = requant(sum(coef[i] * trim(sample[i])))
//; # Each sample is trimmed, multiplied by its coefficient, the products requantized to one
//; # binary point, summed in groups, the total requantized into the output format.
//; # Every tap has a bit of tap_en. Where the tap is registered the bit gates that tap's
//; # clock, so a disabled tap holds its last product; where it is not, the bit zeroes the
//; # sample instead. PIPE names the stages that carry a register.
//; # Rounding modes: trunc, half_up, half_even, half_away, to_zero.
//; import textwrap
//; from dataclasses import dataclass
//; import partition
//; import qfmt
//; from vexpr import decl, idx, lit, pad_low, parenthesize
//;
//; #
//; # parameters: (scalar or list) takes one value or a list of N_TAPS.
//; N_TAPS        = parameter('N_TAPS',        8)          # number of taps
//; Q_SMPL        = parameter('Q_SMPL',        'Q1.5')     # sample format, shared by every tap
//; Q_TRMSMPL     = parameter('Q_TRMSMPL',                 # trimmed sample format (scalar or list)
//;     ['Q1.4', 'Q1.5', 'Q1.5', 'Q1.5', 'Q1.5', 'Q1.5', 'Q1.4', 'Q1.4'])
//; TRMSMPL_ROUND = parameter('TRMSMPL_ROUND', 'half_up')  # rounding mode of the sample trim
//; TRMSMPL_SYM   = parameter('TRMSMPL_SYM',   0)          # symmetric clamp on the sample trim: 0/1
//; ISYM_SMPL     = parameter('ISYM_SMPL',     1)          # samples never take their min code: 0/1
//; Q_COEF        = parameter('Q_COEF',                    # coefficient format (scalar or list)
//;     ['Q2.5', 'Q4.5', 'Q6.5', 'Q6.5', 'Q6.5', 'Q4.5', 'Q2.5', 'Q1.5'])
//; ISYM_COEF     = parameter('ISYM_COEF',     1)          # coefficients never take min code: 0/1
//; PROD_FRAC     = parameter('PROD_FRAC',     None)       # product frac bits; None derives it
//; PROD_ROUND    = parameter('PROD_ROUND',    'trunc')    # rounding mode of the product requant
//; N_GROUPS      = parameter('N_GROUPS',      2)          # number of groups: 1 .. N_TAPS
//; TAP_GROUPS    = parameter('TAP_GROUPS',    None)       # (scalar or list) group index, or None
//; PARENTH       = parameter('PARENTH',       1)          # balance the adder trees: 0/1
//; Q_RESULT      = parameter('Q_RESULT',      'Q6.5')     # output format
//; RESULT_ROUND  = parameter('RESULT_ROUND',  'half_up')  # rounding mode of the output requant
//; RESULT_SYM    = parameter('RESULT_SYM',    1)          # symmetric clamp on the output: 0/1
//; PIPE          = parameter('PIPE',                      # registered stages: trmsmpl, prod,
//;     ['prod', 'groups'])                                #   groups, result -- or 'none'
//;
//; # Indexed name minimum width
//; IDX_W = 2
//; #
//; # records: per-tap and per-net state, filled in as the build proceeds
//; @dataclass
//; class Tap:
//;     index:       int                  # tap number; names its ports and nets
//;     trmsmpl_fmt: qfmt.Fmt             # Q_TRMSMPL[index]
//;     coef_fmt:    qfmt.Fmt             # Q_COEF[index]
//;     trim:        qfmt.Requant = None  # sample -> qsample
//;     prod_bounds: qfmt.Bounds = None   # exact product range
//;     prod_rq:     qfmt.Requant = None  # prod -> qprod; its dst is Q_PROD[index]
//;     group:       int = None
//; # endclass
//;
//; #
//; # helpers: small utilities, the leaf-function collector and the net table
//; def derive(fn, *args, **kw):
//;     try:
//;         return fn(*args, **kw)
//;     except (qfmt.QError, partition.PartitionError) as e:
//;         error(f"{mname}: {e}")
//; # enddef
//;
//; def broadcast(name, v):
//;     vs = list(v) if isinstance(v, (list, tuple)) else [v]
//;     if len(vs) == 1:
//;         vs = vs * N_TAPS
//;     # endif
//;     if len(vs) != N_TAPS:
//;         error(f"{mname}: {name} has {len(vs)} entries; want 1 or N_TAPS={N_TAPS}")
//;     # endif
//;     return vs
//; # enddef
//;
//; # PIPE names the stages that carry a register, in any order; 'none' or an empty list
//; # is none of them. A sweep spells the list with commas, and -p carries a scalar, so the
//; # value can arrive as one string.
//; STAGES = ('trmsmpl', 'prod', 'groups', 'result')
//; def pipe_stages(v):
//;     names = list(v) if isinstance(v, (list, tuple)) else str(v).split(',')
//;     names = [n for n in (str(x).strip() for x in names) if n]
//;     if names == ['none']:
//;         names = []
//;     # endif
//;     for n in names:
//;         if n not in STAGES:
//;             error(f"{mname}: PIPE names {n!r}; each stage must be one of "
//;                 f"{', '.join(STAGES)}, or the whole list 'none'")
//;         # endif
//;         if names.count(n) > 1:
//;             error(f"{mname}: PIPE names {n!r} more than once")
//;         # endif
//;     # endfor
//;     return [n for n in STAGES if n in names]
//; # enddef
//;
//; def qname(f):
//;     return f.to_q().lower().replace('-', 'm').replace('.', '_')
//; # enddef
//;
//; def tap_note(t):
