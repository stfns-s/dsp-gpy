//;
//; # RTL: the header comment, the ports, then the body. Each net is written where it is
//; # built, so a derivation and the line it produces stay together. Only a group sum has more
//; # than one term, so wrap_expr is used there and nowhere else. The functions the expressions
//; # ask for are collected as they are built and emitted after the body.
//; GUARD = f"__{mname.upper()}__"
//; # Icarus 12 cannot connect a one-element unpacked array port and verilator cannot connect
//; # an element in its place, so at N_TAPS=1 sample is a plain port
//; xdim   = f" [0:{N_TAPS-1}]" if N_TAPS > 1 else ""
