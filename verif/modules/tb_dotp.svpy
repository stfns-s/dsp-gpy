//; # back from the instance below; nothing here restates one.
//; # (scalar or list) takes one value or a comma list of N_TAPS
//; N_TAPS        = parameter('N_TAPS',        None)       # number of taps
//; Q_SMPL        = parameter('Q_SMPL',        None)       # sample format, shared by every tap
//; Q_TRMSMPL     = parameter('Q_TRMSMPL',     None)       # trimmed sample format (scalar or list)
//; TRMSMPL_ROUND = parameter('TRMSMPL_ROUND', None)       # rounding of the sample trim
//; TRMSMPL_SYM   = parameter('TRMSMPL_SYM',   None)       # symmetric clamp on the trim
//; ISYM_SMPL     = parameter('ISYM_SMPL',     None)       # samples never take their min code
//; Q_COEF        = parameter('Q_COEF',        None)       # coefficient format (scalar or list)
//; ISYM_COEF     = parameter('ISYM_COEF',     None)       # coefficients never take their min code
//; PROD_FRAC     = parameter('PROD_FRAC',     None)       # product frac bits; dotp derives if None
