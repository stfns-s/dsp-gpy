//; include('tb_util.svpy')

//; # a one-element unpacked array cannot be connected under Icarus 12, so dotp declares a
//; # plain port at N_TAPS=1 and the testbench matches it. Above that the port takes the
//; # array, but the vectors are driven into one variable per tap, which continuous
//; # assignments gather: verilator 5.020 raises no event for a procedural write to an
//; # element of an unpacked array, so a design node that reads only the array -- a trimmed
//; # sample, with nothing else in its cone -- keeps the value it took at time zero.
//; def sample_elem(i):
//;     return 'sample' if N_TAPS == 1 else idx('sample', i, N_TAPS, IDX_W)
//; # enddef
//; def coef(i):
//;     return idx('coef', i, N_TAPS, IDX_W)
//; # enddef
//; if N_TAPS == 1:
    logic `decl(F_SMPL)` sample;
//; else:
//;     for i in range(N_TAPS):
    logic `decl(F_SMPL)` `sample_elem(i)`;
//;     # endfor
    wire  `decl(F_SMPL)` sample [0:`N_TAPS-1`];
//;     for i in range(N_TAPS):
    assign sample[`i`] = `sample_elem(i)`;
//;     # endfor
//; # endif
//; for i in range(N_TAPS):
    logic `decl(F_COEF[i])` `coef(i)`;
//; # endfor
    logic [`N_TAPS-1`:0] tap_en;
    wire  `decl(F_RESULT)` result;
    logic clk = 1'b0;
//; if CLK:

    always #5 clk = ~clk;
//; # endif

//; conns  = ['.result(result)', '.sample(sample)']
//; conns += [f'.{coef(i)}({coef(i)})' for i in range(N_TAPS)]
//; conns += ['.tap_en(tap_en)']
//; conns += ['.clk(clk)']
    `dut.instantiate()` (
        `', '.join(conns)`
    );

    // expected output per check point; the inputs of the vectors not rebuilt from their index
    longint yexp [0:`NCP-1`];
//; if NT:
    longint xtab [0:`NT*N_TAPS-1`];
    longint htab [0:`NT*N_TAPS-1`];
//; # endif
//; if N_TAPS > 8:
    longint cmask [0:`NC-1`];
//; # endif
//; if HAS_CHK:
    bit     chk  [0:`NCP-1`];
//; # endif
    logic [`N_TAPS-1`:0] ent [0:`NV-1`];
    longint tmp, m;
    int     hv, ev, n;

//; for ci, ch in enumerate(CHUNKS):
    task load_`ci`;
        begin
//;     for r in ch:
            `r`
//;     # endfor
        end
    endtask

//; # endfor
    task load_tables;
        begin
//; if HAS_CHK:
            for (int i = 0; i < `NCP`; i++) chk[i] = 1'b1;
//; # endif
//; for ci in range(len(CHUNKS)):
            load_`ci`;
//; # endfor
        end
    endtask

    // vector v: its samples, its tap_en, and the coefficients of vector v, or of vector v-1
    // when PIPE registers the trimmed samples, so that sample and coefficient meet at the
    // multiplier. Past the last vector the samples go to zero and the rest holds.
    task drive(input int v);
        begin
            if (v < `NC`) begin
                m = `"longint'(v)" if N_TAPS <= 8 else 'cmask[v]'`;
//; for i in range(N_TAPS):
                tmp = m[`2 * i`] ? `XHI` : `XLO`;
                `sample_elem(i)` = tmp[`XW-1`:0];
//; # endfor
            end
//; if NT:
            else if (v < `NV`) begin
//;     for i in range(N_TAPS):
                tmp = xtab[(v - `NC`) * `N_TAPS` + `i`];
                `sample_elem(i)` = tmp[`XW-1`:0];
//;     # endfor
            end
//; # endif
            else begin
//; for i in range(N_TAPS):
                tmp = 0;
                `sample_elem(i)` = tmp[`XW-1`:0];
//; # endfor
            end
            hv = v - `pipe_trmsmpl`;
            if (hv < 0) hv = 0;
            if (hv > `NV-1`) hv = `NV-1`;
            if (hv < `NC`) begin
                m = `"longint'(hv)" if N_TAPS <= 8 else 'cmask[hv]'`;
//; for i in range(N_TAPS):
                tmp = m[`2 * i + 1`] ? `HHI[i]` : `HLO[i]`;
                `coef(i)` = tmp[`F_COEF[i].width-1`:0];
//; # endfor
            end
//; if NT:
            else begin
//;     for i in range(N_TAPS):
                tmp = htab[(hv - `NC`) * `N_TAPS` + `i`];
                `coef(i)` = tmp[`F_COEF[i].width-1`:0];
//;     # endfor
            end
//; # endif
            ev = v;
            if (ev > `NV-1`) ev = `NV-1`;
            tap_en = ent[ev];
        end
    endtask

    // the latency probes: samples at zero or at PX, coefficients at H0 or H1, gates open
    task drive_probe(input bit step_x, input bit step_h);
        begin
//; for i in range(N_TAPS):
            tmp = step_x ? `PX[i]` : 0;
            `sample_elem(i)` = tmp[`XW-1`:0];
//; # endfor
//; for i in range(N_TAPS):
            tmp = step_h ? `H1[i]` : `H0[i]`;
            `coef(i)` = tmp[`F_COEF[i].width-1`:0];
//; # endfor
            tap_en = {`N_TAPS`{1'b1}};
        end
    endtask

    // one clock edge: from the drive point at a negedge, through the posedge, to the next
    // negedge. Without a clock a delay stands in for the edge, so the same loops run.
    task step;
        begin
//; if CLK:
            @(posedge clk);
            @(negedge clk);
//; else:
            #4;
//; # endif
        end
    endtask

    // check 3: clock edges from a sample step to result, then from a coefficient step to
    // result, counted rather than assumed. A step is applied at the drive point and result
    // is read #1 later, so a combinational path counts zero. The counts stop at
    // LATENCY_SMPL + 3 so a dead design fails the check instead of hanging.
    task probe_latency;
        begin
            drive_probe(1'b0, 1'b0);
            repeat (`LATENCY_SMPL + 2`) step;
            #1;
            tb_check(64'(result), `PY_IDLE`, "probe: idle output");
            drive_probe(1'b1, 1'b0);
            #1;
            n = 0;
            while (64'(result) !== `PY0` && n < `LATENCY_SMPL + 3`) begin
                step;
                #1;
                n = n + 1;
            end
            tb_check(64'(n), `LATENCY_SMPL`, "LATENCY_SMPL: edges from sample to result");
            drive_probe(1'b1, 1'b1);
            #1;
            n = 0;
            while (64'(result) !== `PY1` && n < `LATENCY_COEF + 3`) begin
                step;
                #1;
                n = n + 1;
            end
            tb_check(64'(n), `LATENCY_COEF`, "LATENCY_COEF: edges from coef to result");
        end
    endtask

    initial begin
        $display("  dotp: N_TAPS=`N_TAPS` TAP_GROUPS=`','.join(str(g) for g in TAP_GROUPS)`");
        $display("  dotp: PROD_FRAC=`PROD_FRAC`");
        $display("  dotp: Q_PROD=`dut.get_param('Q_PROD')` Q_GROUPS=`dut.get_param('Q_GROUPS')`");
        $display("  dotp: Q_SUM=`dut.get_param('Q_SUM')`");
        $display("  dotp: PIPE=`','.join(PIPE) if PIPE else 'none'`");
        $display("  dotp: LATENCY_SMPL=`LATENCY_SMPL` LATENCY_COEF=`LATENCY_COEF`");
        $display("  vectors: %0d, %0d corners, %0d tabulated", `NV`, `NC`, `NT`);
        load_tables;
//; if CLK:
        @(negedge clk);
//; # endif
        // check point v: the inputs of vector v are applied at a negedge and result is read
        // #1 later, before the next edge, so it shows the registers as v edges left them.
        // yexp is indexed by check point, not by vector: a held tap breaks the fixed
        // pipeline delay that would let one stand in for the other. The run continues
        // LATENCY_SMPL points past the last vector to flush it.
        for (int v = 0; v < `NCP`; v++) begin
            drive(v);
            #1;
//; if HAS_CHK:
            if (chk[v]) tb_check(64'(result), yexp[v], $sformatf("check point %0d", v));
//; else:
            tb_check(64'(result), yexp[v], $sformatf("check point %0d", v));
//; # endif
            step;
        end
        probe_latency;
        tb_report("`CFG`");
        $finish;
    end
endmodule
