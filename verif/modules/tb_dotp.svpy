//; PARENTH       = parameter('PARENTH',       None)       # balance the adder trees
//; Q_RESULT      = parameter('Q_RESULT',      None)       # output format
//; RESULT_ROUND  = parameter('RESULT_ROUND',  None)       # rounding mode of the output requant
//; RESULT_SYM    = parameter('RESULT_SYM',    None)       # symmetric clamp on the output
//; PIPE          = parameter('PIPE',          None)       # registered stages (or 'none')
//; NRAND         = parameter('NRAND',         500)        # random vectors in the first block
//; SEED          = parameter('SEED',          1)          # seed of every random draw
//; # -p carries scalars, so a sweep spells a per-tap list with commas and it is split here;
//; # str(v) because a one-element numeric list arrives already coerced (-p TAP_GROUPS=0 is an
//; # int). The parts are passed on as they are: dotp broadcasts a single entry over its taps
